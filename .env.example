# -----------------------------------------------------------------------------
# MESA & MINT — environment variables
# Copy this file to `.env.local` for local development. Never commit `.env.local`.
# On Vercel, add the same keys under Project → Settings → Environment Variables.
# -----------------------------------------------------------------------------

# Public origin of the deployed site, used for canonical URLs, Open Graph,
# the sitemap and structured data. No trailing slash.
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email delivery (Resend) -------------------------------------------------
# Reservation requests and contact enquiries are emailed to the restaurant.
# If RESEND_API_KEY, RESERVATION_FROM_EMAIL or RESERVATION_TO_EMAIL is missing,
# the forms clearly tell visitors that requests are NOT being sent.

# Server-side secret from https://resend.com/api-keys
RESEND_API_KEY=

# Sender address on a domain verified in Resend, e.g.
#   MESA & MINT <reservations@your-restaurant.com>
# For quick testing you may use Resend's sandbox sender: onboarding@resend.dev
# (the sandbox can only deliver to the email address on your Resend account).
RESERVATION_FROM_EMAIL=

# Inbox that receives reservation requests.
RESERVATION_TO_EMAIL=

# Optional: inbox for contact-form enquiries. Defaults to RESERVATION_TO_EMAIL.
CONTACT_TO_EMAIL=

# --- WhatsApp (optional) -----------------------------------------------------
# International number, digits only, including country code (e.g. 919876543210).
# Leave empty to show a "not yet available" card instead of a dead link.
NEXT_PUBLIC_WHATSAPP_NUMBER=
